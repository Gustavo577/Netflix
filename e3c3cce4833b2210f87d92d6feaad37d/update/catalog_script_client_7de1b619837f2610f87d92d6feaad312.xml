        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading) {
      return;
   }
  var ga = new GlideAjax('MediaUtilsClient');
    ga.addParam('sysparm_name', 'getMediaData');
    ga.addParam('sysparm_media_sys_id', newValue);

    ga.getXMLAnswer(function(response){
		var objResponse = JSON.parse(response);
		g_form.setValue("avarage_rating", objResponse.avarage_rating);
		g_form.setValue("question_synopsis", objResponse.question_synopsis);
		top.window.document.getElementById("poster_image").src = !objResponse.question_posterURL ? "" :objResponse.question_posterURL;
	});
   
}]]></script>
